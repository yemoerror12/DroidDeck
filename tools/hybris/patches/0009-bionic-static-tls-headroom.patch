diff --git a/hybris/common/bionic_tls.c b/hybris/common/bionic_tls.c
--- a/hybris/common/bionic_tls.c
+++ b/hybris/common/bionic_tls.c
@@ -90,8 +90,18 @@
  * patcher emit one extra LDR in the thunk to dereference it -- that
  * frees us from the IE-surplus cap entirely, at the cost of growing
  * the thunk from 16 to 20 bytes and matching count_tls/THUNK_SIZE.
+ *
+ * Xiaomi XRING (G2-Ultra NX, Android 17): its vendor Mali driver promotes
+ * a chain of TLS modules -- 984+41 aborted at the old 1024 ceiling; after
+ * raising to 1280 the next frontier module landed at offset 1256 with
+ * memsz 80 (1256 + 80 = 1336 > 1280), aborting again. 1536 covers that
+ * frontier with ~200 bytes of headroom while staying within the glibc
+ * static-TLS surplus documented above (fits gtk3; firefox does not, but
+ * the guest here is gamescope/steam). If the vendor chain outgrows this
+ * ceiling, the escape hatch is the heap-block thunk design described
+ * below instead of raising the IE allocation further.
  */
-#define BIONIC_STATIC_TLS_SIZE   1024
+#define BIONIC_STATIC_TLS_SIZE   1536
 #define BIONIC_TPIDR_OFFSET      8    /* matches StaticTlsLayout::offset_thread_pointer() with MIN_TLS_SLOT=-1 (bionic Q) */
 #define BIONIC_TLS_PTR_OFFSET    0    /* slot -1 (TLS_SLOT_BIONIC_TLS) at TP-8 = 0 */
 #define BIONIC_TLS_COMPAT_SIZE   16384
